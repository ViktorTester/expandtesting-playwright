{
  "name": "automationexercise-playwright",
  "version": "1.0.0",
  "description": "E2E and API tests using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:allure": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:debug": "npx playwright test --debug",
    "allure:generate": "node scripts/allure-generate.cjs",
    "allure:open": "node scripts/allure-open.cjs",
    "allure:serve": "node scripts/allure-serve.cjs",
    "prepare": "husky",
    "test:brand1:dev": "ENV=dev BRAND=brand1 npm test",
    "test:brand1:staging": "ENV=staging BRAND=brand1 npm test",
    "test:brand2:dev": "ENV=dev BRAND=brand2 npm test",
    "test:brand2:staging": "ENV=staging BRAND=brand2 npm test"
  },
  "keywords": [],
  "author": "Viktor K.",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.1.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "eslint": "^9.39.2",
    "eslint-plugin-playwright": "^2.5.1",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0"
  }
}
